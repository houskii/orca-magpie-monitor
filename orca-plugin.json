{
  "manifestVersion": 2,
  "id": "magpie-monitor",
  "name": "Magpie 用量与速度",
  "version": "0.4.0",
  "description": "读取 Magpie 或兼容网关的额度与会话 TPS、Token、缓存统计，支持 Antigravity 原生测速。",
  "engines": {
    "orca": ">=1.4.258"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "magpie-monitor",
        "title": "Magpie 用量与速度",
        "icon": "gauge",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "magpie.refresh",
        "title": "Magpie：刷新用量与会话速度"
      },
      {
        "id": "magpie.sessions",
        "title": "Magpie：查看全部对话与速度"
      }
    ],
    "statusBarItems": [
      {
        "id": "quota5h",
        "text": "Magpie 额度",
        "icon": "gauge",
        "command": "magpie.refresh"
      },
      {
        "id": "quota7d",
        "text": "额度",
        "icon": "gauge",
        "command": "magpie.refresh"
      },
      {
        "id": "speed",
        "text": "0T/s",
        "icon": "zap",
        "command": "magpie.sessions"
      },
      {
        "id": "speed2",
        "text": "0T/s",
        "icon": "zap",
        "command": "magpie.sessions"
      },
      {
        "id": "speed3",
        "text": "0T/s",
        "icon": "zap",
        "command": "magpie.sessions"
      }
    ],
    "settings": [
      {
        "key": "showQuota",
        "title": "显示网关账号额度",
        "type": "boolean",
        "default": true,
        "description": "同时控制侧栏、底栏和弹窗中的账号额度。关闭后停止额度查询，保留会话 TPS、Token 和缓存统计。"
      },
      {
        "key": "quotaProvider",
        "title": "额度来源 ID",
        "type": "string",
        "default": "auto",
        "description": "auto 自动选择网关返回的首个可用来源；也可填写 provider ID 或在面板中选择，不内置供应商适配。"
      },
      {
        "key": "baseURL",
        "title": "统计网关地址",
        "type": "string",
        "default": "http://127.0.0.1:3425",
        "description": "Magpie 或提供相同统计接口的网关。支持本机 HTTP、远程 HTTPS 和路径前缀，例如 https://gateway.example.com/monitor。"
      },
      {
        "key": "bearerTokenEnv",
        "title": "网关 Token 环境变量（可选）",
        "type": "string",
        "default": "",
        "description": "需要 Bearer 认证时填写 Orca worker 可见的环境变量名，例如 MAGPIE_MONITOR_TOKEN。请勿填写 Token 本身。"
      },
      {
        "key": "intervalSeconds",
        "title": "速度采样间隔（秒）",
        "type": "integer",
        "default": 1,
        "minimum": 1,
        "maximum": 10
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    }
  ],
  "license": "MIT",
  "repository": "https://github.com/houskii/orca-magpie-monitor"
}
